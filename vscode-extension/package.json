{
  "name": "pacepilot-vscode",
  "displayName": "PacePilot",
  "description": "PacePilot VS Code integration bridge",
  "version": "0.1.0",
  "publisher": "pacepilot",
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pacepilot.createTask",
        "title": "PacePilot: Create Task"
      },
      {
        "command": "pacepilot.pause",
        "title": "PacePilot: Pause"
      },
      {
        "command": "pacepilot.resume",
        "title": "PacePilot: Resume"
      },
      {
        "command": "pacepilot.stop",
        "title": "PacePilot: Stop"
      },
      {
        "command": "pacepilot.showStatus",
        "title": "PacePilot: Show Status"
      }
    ]
  }
}
